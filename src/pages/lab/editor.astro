---
// Lab version "Editor": the portfolio as a code editor, a fictional fork of VS Code. Each
// section is a file. Real features: command palette, search, outline, minimap, an assistant
// panel, an inline suggestion, a terminal that takes commands, career as git history, stack as
// extensions, notifications and a dark theme. Behaviour lives in src/scripts/editor.ts.
import Proto from "../../components/Proto.astro";
import "@fontsource-variable/hanken-grotesk";
import { content, links, agentIds } from "../../content";

const t = content.es;
const c = t.chat;

type Tok = { cls: string; text: string; href?: string };
type Lang = "md" | "yaml" | "json" | "ts";

// Minimal per-language highlighter: first matching rule wins at each position.
const RULES: Record<Lang, [RegExp, string][]> = {
  md: [[/^#{1,6} .*/y, "h"], [/^> .*/y, "q"], [/^\s*(\d+\.|-) /y, "p"], [/\*\*[^*]+\*\*/y, "b"], [/\[[^\]]+\]\([^)]+\)/y, "a"], [/`[^`]+`/y, "s"]],
  yaml: [[/#.*/y, "c"], [/^\s*- /y, "p"], [/[\w-]+(?=:)/y, "f"], [/"[^"]*"/y, "s"], [/:/y, "p"]],
  json: [[/"[^"]*"(?=\s*:)/y, "f"], [/"[^"]*"/y, "s"], [/[{}\[\],:]/y, "p"]],
  ts: [[/\/\/.*/y, "c"], [/\b(?:export|const|as)\b/y, "k"], [/"[^"]*"/y, "s"], [/\w+(?=:)/y, "f"], [/[{}(),;:=]/y, "p"]],
};
const hrefOf = (s: string) => {
  const v = s.replace(/"/g, "");
  if (v.includes("@")) return `mailto:${v}`;
  if (/^(linkedin|github)\.com/.test(v)) return `https://${v}`;
  return undefined;
};
const tokenize = (lang: Lang, line: string): Tok[] => {
  const out: Tok[] = [];
  let i = 0, plain = "";
  const flush = () => { if (plain) out.push({ cls: "", text: plain }); plain = ""; };
  while (i < line.length) {
    let hit = false;
    for (const [re, cls] of RULES[lang]) {
      re.lastIndex = i;
      const m = re.exec(line);
      if (!m || (re.source.startsWith("^") && i > 0)) continue;
      flush();
      if (cls === "a") {
        const [, label, href] = /\[([^\]]+)\]\(([^)]+)\)/.exec(m[0])!;
        out.push({ cls: "a", text: label, href });
      } else {
        out.push({ cls, text: m[0], href: cls === "s" ? hrefOf(m[0]) : undefined });
      }
      i += m[0].length;
      hit = true;
      break;
    }
    if (!hit) plain += line[i++];
  }
  flush();
  return out;
};

const q = (s: string) => `"${s}"`;
type File = { id: string; name: string; lang: Lang; dir?: string; hidden?: boolean; ghost?: string; src: string[] };
const shortcuts: [string, string][] = [
  ["Ctrl+Shift+P", "Paleta de comandos"], ["Ctrl+P", "Abrir archivo por nombre"], ["Ctrl+G", "Ir a línea"],
  ["Ctrl+B", "Mostrar u ocultar la barra lateral"], ["Ctrl+J", "Mostrar u ocultar el panel"], ["Ctrl+I", "Mostrar u ocultar el asistente"],
  ["Ctrl+Shift+E", "Explorador"], ["Ctrl+Shift+F", "Buscar en los archivos"], ["Ctrl+Shift+G", "Historial (control de código)"],
  ["Ctrl+Shift+X", "Extensiones"], ["Tab", "Aceptar la sugerencia del asistente"], ["Esc", "Cerrar paleta, sugerencia o panel flotante"],
];
const fileList: File[] = [
  { id: "readme", name: "README.md", lang: "md", ghost: "- lab/versiones.md — otras versiones de este sitio", src: [
    `# ${t.hero.lines.join(" ")}`,
    "",
    `**Francisco Jequier** — ${t.hero.kicker}`,
    `${t.footer}`,
    "",
    t.hero.lead,
    "",
    "## Archivos",
    "- metodo.md — cómo trabajo",
    "- agentes.yaml — los cinco roles",
    "- experiencia.json — dónde he trabajado",
    "- contacto.ts — cómo escribirme",
  ] },
  { id: "metodo", name: "metodo.md", lang: "md", src: [
    `# ${t.method.title}`,
    "",
    ...t.method.steps.map(([verb, text], i) => `${i + 1}. **${verb}** — ${text}`),
    "",
    `> ${t.rule.tag}: ${t.rule.a} ${t.rule.hl}, ${t.rule.b}`,
  ] },
  { id: "agentes", name: "agentes.yaml", lang: "yaml", ghost: `decide: ${q("una persona")}  # nada se integra sin revisión`, src: [
    `# ${t.agents.title}`,
    `orquesta: ${q("Francisco Jequier")}`,
    "agentes:",
    ...t.agents.list.flatMap(([name, text], i) => [`  - id: ${agentIds[i]}`, `    rol: ${q(name)}`, `    hace: ${q(text)}`]),
  ] },
  { id: "experiencia", name: "experiencia.json", lang: "json", src: [
    "[",
    ...t.exp.items.flatMap(([dates, role, company, text], i, all) => [
      "  {",
      `    "periodo": ${q(dates)},`,
      `    "rol": ${q(role)},`,
      `    "empresa": ${q(company)},`,
      `    "resumen": ${q(text)}`,
      i < all.length - 1 ? "  }," : "  }",
    ]),
    "]",
  ] },
  { id: "contacto", name: "contacto.ts", lang: "ts", src: [
    `// ${t.contact.text}`,
    "export const contacto = {",
    `  correo: ${q(links.email)},`,
    `  linkedin: ${q("linkedin.com/in/francisco-jequier")},`,
    `  github: ${q("github.com/FcoJequier")},`,
    "} as const;",
  ] },
  { id: "versiones", name: "versiones.md", lang: "md", dir: "lab", src: [
    `# ${t.lab.title}`,
    "",
    "- [Chat](/) — la versión principal",
    ...c.versionList.filter(([href]) => href !== "/lab/editor/").map(([href, name, text]) => `- [${name}](${href}) — ${text}`),
    `- [Código de este sitio](${links.repo})`,
    "",
    `> ${c.labNext}`,
  ] },
  { id: "atajos", name: "atajos.md", lang: "md", hidden: true, src: [
    "# Atajos de teclado",
    "",
    ...shortcuts.map(([k, v]) => `- \`${k}\` — ${v}`),
    "",
    "> En la terminal: escribe `help` para ver los comandos.",
  ] },
];
const files = fileList.map((f) => ({ ...f, lines: f.src.map((l) => tokenize(f.lang, l)), ghostToks: f.ghost ? tokenize(f.lang, f.ghost) : null }));

// Minimap: one bar per line, coloured by its first highlighted token.
const miniBar = (raw: string, toks: Tok[]) => {
  const indent = raw.length - raw.trimStart().length;
  return { left: Math.min(indent, 20) * 1.1, width: Math.min(raw.trim().length, 90) * 1.1, cls: toks.find((tk) => tk.cls)?.cls ?? "" };
};

const badge: Record<Lang, string> = { md: "M↓", yaml: "!", json: "{}", ts: "TS" };
const langName: Record<Lang, string> = { md: "Markdown", yaml: "YAML", json: "JSON", ts: "TypeScript" };
const menu = ["Archivo", "Editar", "Selección", "Ver", "Ir", "Terminal", "Ayuda"];
const extensions = t.stack.groups.flatMap(([group, items]) => items.map((name) => [name, group] as const));

// Assistant answers: short text + the file that holds the detail.
const answers = {
  quien: { text: `Francisco Jequier ${c.who} ${t.hero.lead}`, file: "readme" },
  metodo: { text: `${t.method.title} ${t.method.steps.map(([v]) => v).join(", ")}. ${t.rule.a} ${t.rule.hl}.`, file: "metodo" },
  agentes: { text: `${t.agents.title} ${t.agents.list.map(([n]) => n).join(", ")}.`, file: "agentes" },
  experiencia: { text: `${t.exp.title} Hoy: ${t.exp.items[0][1]} en ${t.exp.items[0][2]}.`, file: "experiencia" },
  lab: { text: `${t.lab.title} ${c.labMore}`, file: "versiones" },
  contacto: { text: t.contact.text, file: "contacto" },
  nose: { text: c.unknown, file: "" },
};
const data = {
  files: files.map((f) => ({ id: f.id, name: f.name, path: f.dir ? `${f.dir}/${f.name}` : f.name, lang: f.lang, hidden: !!f.hidden, lines: f.src })),
  answers,
  topics: c.topics.map(([id, short]) => [id, short]),
  log: t.log,
  links,
  versions: [["chat", "/"], ...c.versionList.map(([href, name]) => [name.toLowerCase(), href])],
  who: `Francisco Jequier — ${t.hero.kicker}`,
  exp: t.exp.items.map(([dates, role, company]) => [dates, role, company]),
};
---
<Proto name="Editor" cls="p4">
  <script is:inline>try{if(localStorage.getItem("ed-theme")!=="light")document.documentElement.dataset.theme="dark"}catch{}</script>
  <div class="app">
    <header class="titlebar">
      <span class="logo" aria-hidden="true"></span>
      <a class="back" href="/">← Chat</a>
      <span class="menu" aria-hidden="true">{menu.map((m) => <span>{m}</span>)}</span>
      <button type="button" class="command" data-cmd="palette" aria-label="Abrir la paleta de comandos (Ctrl+Shift+P)">
        <span>⌕ francisco-jequier</span><kbd>Ctrl+Shift+P</kbd>
      </button>
      <button type="button" class="theme-btn" data-cmd="theme" data-theme-label aria-label="Cambiar tema" title="Cambiar entre tema claro y oscuro" aria-pressed="true">☀ Claro</button>
      <span class="layout">
        <button type="button" data-cmd="sidebar" aria-label="Barra lateral (Ctrl+B)" title="Barra lateral (Ctrl+B)"><svg viewBox="0 0 16 16"><rect x="1.5" y="2.5" width="13" height="11" rx="1" /><path d="M6 2.5v11" /></svg></button>
        <button type="button" data-cmd="panel" aria-label="Panel (Ctrl+J)" title="Panel (Ctrl+J)"><svg viewBox="0 0 16 16"><rect x="1.5" y="2.5" width="13" height="11" rx="1" /><path d="M1.5 9.5h13" /></svg></button>
        <button type="button" data-cmd="assist" aria-label="Asistente (Ctrl+I)" title="Asistente (Ctrl+I)"><svg viewBox="0 0 16 16"><rect x="1.5" y="2.5" width="13" height="11" rx="1" /><path d="M10 2.5v11" /></svg></button>
      </span>
      <span class="win" aria-hidden="true"><i>—</i><i>▢</i><i>✕</i></span>
    </header>

    <nav class="activity" aria-label="Vistas">
      <button type="button" data-view="explorer" title="Explorador (Ctrl+Shift+E)" aria-label="Explorador"><svg viewBox="0 0 24 24"><path d="M5 3h9l5 5v13H5z M14 3v5h5" /></svg></button>
      <button type="button" data-view="search" title="Buscar (Ctrl+Shift+F)" aria-label="Buscar"><svg viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="6" /><path d="M15 15l5 5" /></svg></button>
      <button type="button" data-view="scm" title="Control de código (Ctrl+Shift+G)" aria-label="Control de código"><svg viewBox="0 0 24 24"><circle cx="6" cy="5" r="2" /><circle cx="6" cy="19" r="2" /><circle cx="18" cy="8" r="2" /><path d="M6 7v10M18 10c0 5-12 2-12 7" /></svg><em>{t.exp.items.length}</em></button>
      <button type="button" data-view="ext" title="Extensiones (Ctrl+Shift+X)" aria-label="Extensiones"><svg viewBox="0 0 24 24"><rect x="3" y="11" width="8" height="8" /><rect x="11" y="11" width="8" height="8" /><rect x="11" y="3" width="8" height="8" transform="rotate(12 15 7)" /></svg></button>
      <button type="button" data-view="agents" title="Agentes" aria-label="Agentes"><svg viewBox="0 0 24 24"><path d="M12 3l2 6 6 2-6 2-2 6-2-6-6-2 6-2z" /></svg><em class="dot" hidden></em></button>
      <span class="grow"></span>
      <button type="button" data-cmd="theme" title="Tema claro u oscuro" aria-label="Cambiar tema"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8" /><path d="M12 4a8 8 0 0 1 0 16z" class="fill" /></svg></button>
    </nav>

    <aside class="side" aria-label="Barra lateral">
      <section data-view-pane="explorer">
        <p class="head">Explorador</p>
        <p class="root">▾ francisco-jequier</p>
        <ul class="tree">
          {files.filter((f) => !f.hidden).map((f) => (
            <li class:list={{ nested: f.dir }}>
              {f.dir && <span class="dir">▾ {f.dir}</span>}
              <button type="button" data-open={f.id}><b class={`b-${f.lang}`}>{badge[f.lang]}</b>{f.name}</button>
            </li>
          ))}
        </ul>
        <p class="head sub">Esquema</p>
        <ul class="outline" data-outline></ul>
      </section>

      <section data-view-pane="search" hidden>
        <p class="head">Buscar</p>
        <input class="field" type="search" data-search placeholder="Buscar en los archivos" aria-label="Buscar en los archivos" />
        <p class="hint" data-search-count>Escribe al menos 2 letras. Prueba con «agentes» o «Angular».</p>
        <ul class="results" data-results></ul>
      </section>

      <section data-view-pane="scm" hidden>
        <p class="head">Control de código</p>
        <form class="commit" data-commit>
          <textarea class="field" name="msg" rows="3" placeholder="Escríbeme un mensaje (se abrirá tu correo)" aria-label="Mensaje para Francisco"></textarea>
          <button type="submit" class="primary">✓ Enviar por correo</button>
        </form>
        <p class="head sub">Historial · main</p>
        <ol class="graph">
          {t.exp.items.map(([dates, role, company], i) => (
            <li>
              <button type="button" data-commit-at={i}>
                <i class:list={{ head: i === 0 }}></i>
                <span><b>{role}</b> @ {company}</span>
                <time>{dates}</time>
                {i === 0 && <em>HEAD → main</em>}
              </button>
            </li>
          ))}
        </ol>
      </section>

      <section data-view-pane="ext" hidden>
        <p class="head">Extensiones</p>
        <input class="field" type="search" data-ext-filter placeholder="Filtrar extensiones instaladas" aria-label="Filtrar extensiones" />
        <p class="head sub">Instaladas · {extensions.length}</p>
        <ul class="exts">
          {extensions.map(([name, group]) => (
            <li data-ext={name.toLowerCase()}>
              <span class="tile" aria-hidden="true">{name.replace(/[^A-Za-z]/g, "").slice(0, 2)}</span>
              <span><b>{name}</b><small>{group}</small></span>
              <em>instalada</em>
            </li>
          ))}
        </ul>
      </section>

      <section data-view-pane="agents" hidden>
        <p class="head">Agentes</p>
        <button type="button" class="primary" data-cmd="run">▶ Ejecutar simulación</button>
        <div class="progress" aria-hidden="true"><i data-progress></i></div>
        <ul class="agent-list">
          {t.agents.list.map(([name, text], i) => (
            <li data-agent={agentIds[i]}><i></i><code>{agentIds[i]}</code><span><b>{name}</b><small>{text}</small></span></li>
          ))}
          <li data-agent="humano" class="me"><i></i><code>yo</code><span><b>Revisión humana</b><small>Revisa y decide qué se integra.</small></span></li>
        </ul>
        <p class="hint">{t.hero.simNote}</p>
      </section>
    </aside>

    <main class="editor">
      <div class="tabs" role="tablist" aria-label="Archivos abiertos">
        {files.map((f) => (
          <div class="tab" data-tab={f.id} hidden={f.hidden}>
            <button type="button" role="tab" data-open={f.id}><b class={`b-${f.lang}`}>{badge[f.lang]}</b>{f.name}</button>
            <button type="button" class="x" data-close={f.id} aria-label={`Cerrar ${f.name}`}>✕</button>
          </div>
        ))}
      </div>
      <p class="crumbs">francisco-jequier › <span data-crumb>README.md</span></p>
      <div class="code" data-code>
        {files.map((f) => (
          <section class="pane" data-pane={f.id} data-lang={langName[f.lang]} hidden>
            <div class="lines">
              {f.lines.map((toks, l) => (
                <div class="ln" style={`--l:${Math.min(l, 24)}`}><code>{toks.map((tk) =>
                  tk.href ? <a class={tk.cls} href={tk.href} rel={tk.href.startsWith("http") ? "noopener" : undefined}>{tk.text}</a>
                  : tk.cls ? <span class={tk.cls}>{tk.text}</span> : tk.text
                )}{toks.length === 0 && " "}</code></div>
              ))}
              {f.ghostToks && (
                <div class="ln ghost" data-ghost hidden><code>{f.ghostToks.map((tk) => tk.cls ? <span class={tk.cls}>{tk.text}</span> : tk.text)}<kbd>Tab ⇥ aceptar · Esc descartar</kbd></code></div>
              )}
            </div>
            <div class="mini" aria-hidden="true">
              {f.src.map((raw, l) => { const b = miniBar(raw, f.lines[l]); return <i class={b.cls && `m-${b.cls}`} style={`margin-left:${b.left}px;width:${b.width}px`}></i>; })}
              <span class="mini-view" data-mini-view></span>
            </div>
          </section>
        ))}
        <section class="empty" data-pane="empty" hidden>
          <span class="logo big" aria-hidden="true"></span>
          <p>Abre un archivo desde el explorador o con <kbd>Ctrl+P</kbd>.</p>
        </section>
      </div>

      <div class="panel">
        <div class="panel-head" role="tablist" aria-label="Panel">
          <button type="button" role="tab" data-panel-tab="terminal" class="on">Terminal</button>
          <button type="button" role="tab" data-panel-tab="problems">Problemas</button>
          <button type="button" role="tab" data-panel-tab="output">Salida</button>
          <em>{t.hero.simNote}</em>
          <button type="button" class="x" data-cmd="panel" aria-label="Cerrar panel">✕</button>
        </div>
        <div class="panel-body" data-panel-view="terminal">
          <ol class="out" data-out aria-live="polite"></ol>
          <form class="prompt" data-prompt>
            <label><b>francisco@portfolio</b> ~ $</label>
            <input name="cmd" autocomplete="off" spellcheck="false" aria-label="Comando de terminal" placeholder="escribe help" />
          </form>
        </div>
        <div class="panel-body note" data-panel-view="problems" hidden>No se han detectado problemas en el área de trabajo.</div>
        <div class="panel-body note" data-panel-view="output" hidden>
          <p>[astro] sitio estático: sin servidor ni base de datos</p>
          <p>[a11y] respeta la preferencia «reducir movimiento» del sistema</p>
          <p>[privacidad] sin analítica ni cookies: este sitio no registra visitas</p>
        </div>
      </div>
    </main>

    <aside class="assist" aria-label="Asistente">
      <p class="head">Asistente <em>respuestas predefinidas</em><button type="button" class="x" data-cmd="assist" aria-label="Cerrar asistente">✕</button></p>
      <div class="thread" data-thread aria-live="polite">
        <div class="bubble bot">Hola. Pregúntame por Francisco y te abro el archivo donde está el detalle.</div>
      </div>
      <div class="chips">{c.topics.map(([id, short, question]) => <button type="button" data-ask={id} data-q={question}>{short}</button>)}</div>
      <form class="ask" data-ask-form>
        <input name="q" class="field" autocomplete="off" placeholder="Pregunta sobre Francisco…" aria-label="Pregunta para el asistente" />
        <button aria-label="Enviar">↑</button>
      </form>
    </aside>

    <footer class="status">
      <button type="button" data-view="scm">⑂ main</button>
      <button type="button" data-panel-tab="problems">✓ 0 problemas</button>
      <span class="grow"></span>
      <button type="button" data-cmd="goto" data-pos>Ln 1, Col 1</button>
      <span>UTF-8</span>
      <span data-status-lang>Markdown</span>
      <button type="button" data-view="agents" data-agents-status>● 5 agentes</button>
      <button type="button" class="status-theme" data-cmd="theme" data-theme-label aria-label="Cambiar tema" aria-pressed="true">☀ Claro</button>
    </footer>

    <div class="palette" data-palette hidden>
      <div class="palette-box" role="dialog" aria-label="Paleta de comandos">
        <input data-palette-input autocomplete="off" spellcheck="false" aria-label="Comando o archivo" />
        <ul data-palette-list role="listbox"></ul>
        <p class="hint">Archivos sin prefijo · <kbd>&gt;</kbd> comandos · <kbd>:</kbd> ir a línea</p>
      </div>
    </div>
    <div class="toasts" data-toasts aria-live="polite"></div>
  </div>
  <script type="application/json" id="ed-data" set:html={JSON.stringify(data)} />
</Proto>

<style is:global>
  .p4 {
    --mut: color-mix(in srgb, var(--ink) 55%, var(--paper));
    --line: color-mix(in srgb, var(--ink) 16%, var(--paper));
    --hover: color-mix(in srgb, var(--ink) 7%, transparent);
    --field: #fff;
    --chrome: #141414; --chrome-ink: #f3efe6;
    font: 400 13px/1.5 "Hanken Grotesk Variable", sans-serif;
    height: 100dvh; overflow: hidden;
    .pn { display: none; }
    button { font: inherit; color: inherit; background: none; border: 0; cursor: pointer; text-align: left; }
    kbd { font: 500 10.5px var(--mono); padding: 1px 5px; border: 1px solid var(--line); border-radius: 4px; }
    .field { width: 100%; padding: 6px 9px; border: 1px solid var(--line); border-radius: 4px; background: var(--field); color: inherit; font: inherit; outline: none; resize: vertical; }
    .field:focus { border-color: var(--blue); }
    .primary { width: 100%; margin-top: 8px; padding: 6px 10px; border-radius: 4px; background: var(--blue); color: #fff; text-align: center; font-weight: 600; }
    .primary:hover { filter: brightness(1.12); }
    .hint { padding: 8px 2px; color: var(--mut); font-size: 12px; }
    .x { width: 22px; height: 22px; border-radius: 5px; text-align: center !important; font-size: 10px; opacity: .7; }
    .x:hover { background: var(--hover); opacity: 1; }

    .app { position: relative; height: 100%; display: grid; grid-template: 34px minmax(0, 1fr) 24px / 48px var(--side-w, 250px) minmax(0, 1fr) var(--assist-w, 300px); grid-template-areas: "title title title title" "act side ed assist" "status status status status"; }
    .app.no-side { --side-w: 0px; } .app.no-side .side { display: none; }
    .app.no-assist { --assist-w: 0px; } .app.no-assist .assist { display: none; }
    .logo { width: 16px; height: 16px; border-radius: 4px; background: conic-gradient(var(--red) 0 25%, var(--chrome-ink) 0 50%, var(--red) 0 75%, var(--chrome-ink) 0); }
    .logo.big { width: 64px; height: 64px; border-radius: 14px; background: conic-gradient(var(--red) 0 25%, var(--ink) 0 50%, var(--red) 0 75%, var(--ink) 0); opacity: .18; }

    .titlebar { grid-area: title; display: flex; align-items: center; gap: 14px; padding-left: 14px; background: var(--chrome); color: var(--chrome-ink); font-size: 12.5px; }
    .back { padding: 3px 9px; border-radius: 6px; background: var(--red); color: #141414; text-decoration: none; font-weight: 600; }
    .menu { display: flex; gap: 12px; opacity: .7; }
